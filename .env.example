# ── Shared ──────────────────────────────────────────────────────────────
DATABASE_URL=postgres://ato:ato@localhost:5433/ato
# mainnet-beta | devnet | localnet
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
LOG_LEVEL=info

# ── Indexer ─────────────────────────────────────────────────────────────
# Comma-separated extra addresses to watch (beyond facilitators + payment-channels program).
INDEXER_EXTRA_ADDRESSES=
# Also watch every registered agent wallet for direct transfers (MPP charge etc.).
INDEXER_WATCH_AGENT_WALLETS=false
INDEXER_POLL_INTERVAL_MS=5000
INDEXER_CONCURRENCY=8
# Optional: Helius LaserStream (Yellowstone-compatible) for live streaming.
LASERSTREAM_ENDPOINT=
LASERSTREAM_API_KEY=

# ── Scorer ──────────────────────────────────────────────────────────────
SCORE_WINDOW_DAYS=30
SCORE_UNREGISTERED_PAYEES=true

# ── Publisher (holds the oracle publisher key: run it isolated) ───────────
PUBLISHER_KEYPAIR_PATH=./keys/publisher.json
PUBLISHER_DRY_RUN=true
# Only push a score onchain if it moved by at least this many points (or flags changed).
PUBLISHER_MIN_SCORE_DELTA=10

# ── API ─────────────────────────────────────────────────────────────────
PORT=8787
# x402 paywall. Leave X402_PAY_TO empty to serve paid routes for free (dev only).
X402_PAY_TO=
X402_FACILITATOR_URL=https://facilitator.payai.network
# CAIP-2: solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp (mainnet) | solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1 (devnet)
X402_NETWORK=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
X402_PRICE_SCORE=$0.001
X402_PRICE_REPORT=$0.01
X402_PRICE_BATCH=$0.02

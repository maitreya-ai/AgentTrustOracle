# ── Shared ──────────────────────────────────────────────────────────────
DATABASE_URL=postgres://ato:ato@localhost:5433/ato
# mainnet-beta | devnet | localnet
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
LOG_LEVEL=info

# ── Indexer ─────────────────────────────────────────────────────────────
# Comma-separated extra addresses to watch (beyond facilitators + payment-channels program).
INDEXER_EXTRA_ADDRESSES=
# Watch the payment-channels program and known x402 facilitator fee payers.
# Facilitators sign every sponsored x402 tx: very high volume on mainnet, use gRPC there.
INDEXER_WATCH_CHANNELS=true
INDEXER_WATCH_FACILITATORS=true
# Also watch every registered agent wallet (and its stablecoin ATAs) for direct transfers.
INDEXER_WATCH_AGENT_WALLETS=false
INDEXER_POLL_INTERVAL_MS=5000
INDEXER_CONCURRENCY=8
# Client-side RPC pacing (requests/sec, 0 = unlimited). ~3.5 for public RPC endpoints.
INDEXER_RPC_MAX_RPS=0
# Optional: Helius LaserStream (Yellowstone-compatible) for live streaming.
LASERSTREAM_ENDPOINT=
LASERSTREAM_API_KEY=

# ── Scorer ──────────────────────────────────────────────────────────────
SCORE_WINDOW_DAYS=30
SCORE_UNREGISTERED_PAYEES=true

# ── Publisher (holds the oracle publisher key: run it isolated) ───────────
# Governance key for `bun run oracle ...` (init, pause, set-publisher). Use a multisig on mainnet.
ADMIN_KEYPAIR_PATH=~/.config/solana/id.json
PUBLISHER_KEYPAIR_PATH=./keys/publisher.json
PUBLISHER_DRY_RUN=true
# Only push a score onchain if it moved by at least this many points (or flags changed).
PUBLISHER_MIN_SCORE_DELTA=10
# Raw-wallet payees are committed in the Merkle root; materialise their accounts too?
PUBLISHER_INCLUDE_UNREGISTERED=false
# Agents with less raw inflow stay root-only (no rent spent on inactive agents).
PUBLISHER_MIN_RAW_VOLUME_MICROS=1

# ── API ─────────────────────────────────────────────────────────────────
PORT=8787
# x402 paywall. Leave X402_PAY_TO empty to serve paid routes for free (dev only).
X402_PAY_TO=
X402_FACILITATOR_URL=https://facilitator.payai.network
# CAIP-2: solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp (mainnet) | solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1 (devnet)
X402_NETWORK=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
X402_PRICE_SCORE=$0.001
X402_PRICE_REPORT=$0.01
X402_PRICE_BATCH=$0.02
# Wallet used by scripts/devnet/pay-api.ts to pay the API over x402 (devnet USDC).
X402_PAYER_KEYPAIR_PATH=./keys/x402-payer.json
